PORT=3001
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://callhub:callhub@localhost:5432/callhub
REDIS_URL=redis://localhost:6379

# Real Twilio credentials. Setting these does NOT start sending real texts by
# itself — the app always boots in mock mode. An admin must explicitly flip the
# live/mock switch in the web UI (or POST /settings/sms-mode) to go live, and it
# re-validates these credentials at that moment.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM_NUMBER=

# Public base URL Twilio can reach for inbound SMS webhooks (e.g. an ngrok URL in
# dev, or your real domain in production). Used to validate the Twilio request
# signature; falls back to reconstructing from the request if unset, which is
# less reliable behind proxies/tunnels.
PUBLIC_API_URL=

ACTION_NETWORK_API_KEY=
ACTION_NETWORK_SYNC_INTERVAL_MINUTES=15
